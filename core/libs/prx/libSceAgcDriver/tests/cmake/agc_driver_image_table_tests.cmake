if(BUILD_TESTING)
    set(agcIgnoredValidationId "VkDeviceCreateInfo-pNext-pNext")
    string(LENGTH "${agcIgnoredValidationId}" agcIgnoredValidationLength)
    math(EXPR agcIgnoredValidationLast "${agcIgnoredValidationLength} - 1")
    set(agcValidationFailure "")
    foreach(agcIgnoredIndex RANGE ${agcIgnoredValidationLast})
        string(SUBSTRING "${agcIgnoredValidationId}" 0 ${agcIgnoredIndex} agcIgnoredPrefix)
        string(SUBSTRING "${agcIgnoredValidationId}" ${agcIgnoredIndex} 1 agcIgnoredNext)
        string(APPEND agcValidationFailure "|VUID-${agcIgnoredPrefix}[^${agcIgnoredNext}]")
    endforeach()
    set_tests_properties(agc_driver_image_table PROPERTIES TIMEOUT 30
            FAIL_REGULAR_EXPRESSION "SYNC-HAZARD-${agcValidationFailure}|was not found but was requested by env var VK_INSTANCE_LAYERS")
    add_test(NAME agc_driver_nested_image_table COMMAND agc_driver_image_table_tests --nested)
    add_test(NAME agc_driver_nested_image_table_large COMMAND agc_driver_image_table_tests --nested-large)
    add_test(NAME agc_driver_nested_image_table_budget COMMAND agc_driver_image_table_tests --nested-budget)
    set_tests_properties(agc_driver_nested_image_table agc_driver_nested_image_table_large agc_driver_nested_image_table_budget PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_NO_PIPELINE_JOURNAL=1" SKIP_RETURN_CODE 77 TIMEOUT 30 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
    if(WIN32)
        set_tests_properties(agc_driver_nested_image_table agc_driver_nested_image_table_large agc_driver_nested_image_table_budget PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
    endif()
endif()
